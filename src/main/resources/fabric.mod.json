{
  "schemaVersion": 1,
  "id": "manasluflux",
  "version": "${version}",
  "name": "ManasluFlux",
  "description": "ManasluFlux - a Meteor Client addon by piolunson & various ai providers.",
  "authors": [
    "piolunson"
  ],
  "contact": {
    "sources": "https://github.com/piolunson/manasluflux"
  },
  "icon": "assets/manasluflux/icon.png",
  "environment": "client",
  "entrypoints": {
    "meteor": [
      "com.manasluflux.addon.AddonTemplate"
    ]
  },
  "mixins": [
    "manasluflux.mixins.json"
  ],
  "jars": [
    {
      "file": "META-INF/jars/baritone-standalone-fabric-1.19.0.jar"
    }
  ],
  "custom": {
    "meteor-client:color": "225,25,25",
    "modmenu": {
      "parent": {
        "id": "meteor-client"
      }
    }
  },
  "depends": {
    "java": ">=${jdk_version}",
    "minecraft": "${minecraft_version}",
    "meteor-client": "*"
  }
}
